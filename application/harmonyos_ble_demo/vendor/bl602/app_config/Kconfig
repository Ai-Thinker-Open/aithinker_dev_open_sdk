menu "application"
    menu "led config"
        config GPIO_R_LED_PORT
                string "set red led gpio port"
                default AIIO_GPIO_A

        config GPIO_R_LED_PIN
                string "set red led gpio pin"
                default AIIO_GPIO_NUM_14

        config GPIO_G_LED_PORT
                string "set green led gpio port"
                default AIIO_GPIO_A

        config GPIO_G_LED_PIN
                string "set green led gpio pin"
                default AIIO_GPIO_NUM_17

        config GPIO_B_LED_PORT
                string "set blue led gpio port"
                default AIIO_GPIO_A

        config GPIO_B_LED_PIN
                string "set blue led gpio pin"
                default AIIO_GPIO_NUM_3
    endmenu

    menu "key config"
        config KEY_PORT
                string "set key port"
                default AIIO_GPIO_A
        config KEY_PIN
                string "set key pin"
                default AIIO_GPIO_NUM_8
    endmenu
endmenu

