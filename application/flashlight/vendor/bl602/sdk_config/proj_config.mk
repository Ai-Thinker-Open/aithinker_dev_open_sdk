#
#compiler flag config domain
#
#CONFIG_TOOLPREFIX :=
#CONFIG_OPTIMIZATION_LEVEL_RELEASE := 1
#CONFIG_M4_SOFTFP := 1

#
#board config domain
#
CONFIG_BOARD_FLASH_SIZE := 2

#firmware config domain
#

#set CONFIG_ENABLE_ACP to 1 to enable ACP, set to 0 or comment this line to disable
#CONFIG_ENABLE_ACP:=1
CONFIG_BL_IOT_FW_AP:=1
CONFIG_BL_IOT_FW_AMPDU:=0
CONFIG_BL_IOT_FW_AMSDU:=0
CONFIG_BL_IOT_FW_P2P:=0
CONFIG_ENABLE_PSM_RAM:=0
#CONFIG_ENABLE_CAMERA:=1
#CONFIG_ENABLE_BLSYNC:=1
#CONFIG_ENABLE_VFS_SPI:=1
CONFIG_ENABLE_VFS_ROMFS:=1
CONFIG_ADC_ENABLE_TSEN:=1

CONFIG_EASYFLASH_ENABLE:=1

CONFIG_FREERTOS_TICKLESS_MODE:=0

CONFIG_SYS_APP_TASK_STACK_SIZE:=4096
CONFIG_SYS_APP_TASK_PRIORITY:=15
CONFIG_SYS_VFS_ENABLE:=1
CONFIG_SYS_VFS_UART_ENABLE:=0
CONFIG_SYS_AOS_CLI_ENABLE:=0
CONFIG_SYS_AOS_LOOP_ENABLE:=1
CONFIG_SYS_BLOG_ENABLE:=1
CONFIG_SYS_DMA_ENABLE:=1
CONFIG_SYS_USER_VFS_ROMFS_ENABLE:=1

CONFIG_BT:=1
CONFIG_BT_STACK_CLI:=0
CONFIG_BT_MESH ?= 1
CONFIG_BLE_TP_SERVER?=1
CONFIG_BLE_AT_CMD := 1
CONFIG_USE_XTAL32K:=0
CONFIG_ENABLE_STACK_OVERFLOW_CHECK:=0

#mbedtls
CONFIG_MBEDTLS_BIGNUM_USE_HW:=1

#blog enable components format :=blog_testc cli vfs helper
LOG_ENABLED_COMPONENTS:=blog_testc hosal loopset looprt bloop blsync_ble demo_at
ifeq ($(CONFIG_BT_MESH_SYNC),1)
LOG_ENABLED_COMPONENTS += blsync_ble
endif
CONFIG_BL602_USE_ROM_DRIVER:=1
CONFIG_BT_STACK_PTS:=0

CONF_ENABLE_COREDUMP:=0

CFLAGS += -Wformat=0
CFLAGS += -DBL602
CFLAGS += -DMBEDTLS_CERTS_C
CFLAGS += -DCHIP_BIND_EN=1

CFLAGS += -DTCP_SYNMAXRTX=3

# skip server cert verify
CFLAGS += -DCONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=1

# print "CONNECT"/"CLOSE" in IP pass-through mode
CFLAGS += -DPASSTHROUGH_PRINT_IP_STATE=1

# set sysmsg bit2 default value
CFLAGS += -DAT_SYSMSG_BIT2=0

# ble mtu 517
CFLAGS += -DCONFIG_BT_RX_BUF_LEN=517+8
CFLAGS += -DCONFIG_BT_L2CAP_TX_MTU=517

# ble prepare write
CFLAGS += -DCONFIG_BT_ATT_PREPARE_COUNT=8

# call bt_set_name but no update adv name
CFLAGS += -DCONFIG_BT_DEVNAME_NO_ADV

# easyflash cache table size
CFLAGS += -DEF_ENV_CACHE_TABLE_SIZE=24

# set TCP_MSS 688 -> 1460
# CFLAGS += -DCFG_LESS_RAM

CFLAGS += -DMEMP_NUM_NETBUF=8

# app version 
GIT_SHA = $(shell git rev-parse --short HEAD)
APP_VER = "V4.18_P2.4.0"
PROJ_VER = $(APP_VER)-$(GIT_SHA)
CFLAGS += -DPROJ_VER=\"$(PROJ_VER)\"

CFLAGS += -DCUSTOM_LOG_IO
CFLAGS += -DCUSTOM_LOG_TX_IO=4
CFLAGS += -DCUSTOM_LOG_RX_IO=0xff
CFLAGS += -DCUSTOM_LOG_RX_BAUD=921600
