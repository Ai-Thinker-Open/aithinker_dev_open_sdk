+    //            ap_ary_ptr->bssid[2],
+    //            ap_ary_ptr->bssid[3],
+    //            ap_ary_ptr->bssid[4],
+    //            ap_ary_ptr->bssid[5],
+    //            ap_ary_ptr->rssi,
+    //            ap_ary_ptr->auth,
+    //            ap_ary_ptr->ssid);
+    /*store back counter*/
+    (*param1) = counter;
+}
+
+static void cb_scan_complete(void *data, void *param)
+{
+    scan_counter = 0;
+    aiio_wifi_scan_ap_all(scan_ap_ary_p, &scan_counter, cb_scan_item_parse);
+    aiio_log_i("scan complete:%d", scan_counter);
+}
+
+int32_t aiio_blufi_scan_wifi_list(void)
+{
+    if (scan_ap_ary_p == NULL)
+    {
+        scan_ap_ary_p = (aiio_wifi_ap_item_t *)aiio_os_malloc(sizeof(aiio_wifi_ap_item_t) * SCAN_ITEMS_MAX);
+        if (scan_ap_ary_p == NULL)
+        {
+            aiio_log_e("malloc falied");
+            return -1;
+        }
+        memset(scan_ap_ary_p, 0, sizeof(aiio_wifi_ap_item_t) * SCAN_ITEMS_MAX);
+    }
+
+    scan_ap_list = (aiio_blufi_ap_record_t *)malloc(SCAN_ITEMS_MAX * sizeof(aiio_blufi_ap_record_t));
+    if (!scan_ap_list)
+    {
+        aiio_log_e("ap_list malloc fail");
+        return -1;
+    }
+    return aiio_wifi_scan(scan_ap_ary_p, cb_scan_complete, 1);
 }
