+static void bubbleSort(aiio_blufi_ap_record_t *arr, int n)
+{
+    int i, j;
+    for (i = 0; i < n - 1; i++)
+    {
+        // 最后的 i 个元素已经排好序，不需要再比较
+        for (j = 0; j < n - i - 1; j++)
+        {
+            // 如果相邻的元素逆序，则交换它们
+            if (arr[j].rssi < arr[j + 1].rssi)
+            {
+                aiio_blufi_ap_record_t temp = arr[j];
+                arr[j] = arr[j + 1];
+                arr[j + 1] = temp;
+            }
+        }
+    }
+}
